# URL pública del sitio (SIN slash final) — usada por sitemap.ts, robots.ts,
# metadataBase y todas las OG images/canonical. En producción debe apuntar
# al dominio real (ej. https://miranashop.com), NUNCA a localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma — MySQL
# ⚠️ Hoy local y producción comparten la misma base remota. Cualquier comando
# que escriba (db:push, db:seed) impacta la tienda en vivo. Lo recomendable es
# apuntar esto a una base de desarrollo propia.
DATABASE_URL="mysql://usuario:password@host:3306/basededatos"

# Base espejo para `pnpm db:migrate` (prisma migrate dev). Prisma la crea y
# destruye en cada validación del diff; en hosting compartido el usuario no
# tiene permiso para crear bases, así que hay que crear a mano una segunda base
# VACÍA y ponerla aquí. Solo hace falta en desarrollo: `db:migrate:deploy`
# (producción) no la usa.
SHADOW_DATABASE_URL="mysql://usuario:password@host:3306/basededatos_shadow"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
BETTER_AUTH_SECRET=""

# WhatsApp — flujo de pago manual (botón "Enviar comprobante" en checkout)
# Número en formato E.164 sin "+" para el enlace wa.me, ej: 51987654321
NEXT_PUBLIC_WHATSAPP_PHONE=""
# Número formateado para mostrar al usuario, ej: "+51 987 654 321"
NEXT_PUBLIC_WHATSAPP_PHONE_DISPLAY=""

# Credenciales del usuario admin creado por prisma/seed.ts (opcional, tiene defaults de dev)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Cloudinary — subida y almacenamiento de imágenes (dashboard.cloudinary.com > API Keys)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"