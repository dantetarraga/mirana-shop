# Copia este archivo como .env y usa una base exclusiva de desarrollo.

# URL pública, sin slash final. Es obligatoria en producción para metadata y
# redirects seguros; debe ser el dominio HTTPS real, nunca localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma — MySQL local o una instancia aislada de desarrollo.
DATABASE_URL="mysql://mirana:mirana@127.0.0.1:3306/mirana_dev"

# Base espejo para `pnpm db:migrate` (prisma migrate dev). Prisma la crea y
# destruye en cada validación del diff; en hosting compartido el usuario no
# tiene permiso para crear bases, así que hay que crear a mano una segunda base
# VACÍA y ponerla aquí. Solo hace falta en desarrollo: `db:migrate:deploy`
# (producción) no la usa.
SHADOW_DATABASE_URL="mysql://mirana:mirana@127.0.0.1:3306/mirana_shadow"

# Auth.js v5. Genera secretos largos y distintos para cada entorno.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Tareas internas: mínimo 32 bytes aleatorios. No se aceptan en query strings.
CRON_SECRET=""
# Opcional: si queda vacío se usa AUTH_SECRET para los HMAC del rate limit.
RATE_LIMIT_SECRET=""

# Minutos durante los que un pedido sin pagar conserva stock (10–1440).
ORDER_RESERVATION_TTL_MINUTES="60"

# WhatsApp — flujo de pago manual (botón "Enviar comprobante" en checkout)
# Número en formato E.164 sin "+" para el enlace wa.me, ej: 51987654321
NEXT_PUBLIC_WHATSAPP_PHONE=""
# Número formateado para mostrar al usuario, ej: "+51 987 654 321"
NEXT_PUBLIC_WHATSAPP_PHONE_DISPLAY=""

# Credenciales del admin que crea prisma/seed.ts. Obligatorias para el seed (no
# hay valores por defecto; contraseña de 12+ caracteres). Si el admin ya existe,
# el seed no cambia su contraseña. Nunca se imprimen en consola.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Solo para una operación consciente contra una DB remota. No persistir en .env.
# ALLOW_REMOTE_DB_WRITE="I_UNDERSTAND"

# Cloudinary — subida y almacenamiento de imágenes (dashboard.cloudinary.com > API Keys)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Correo transaccional (constancia y respuesta del Libro de Reclamaciones,
# obligatorias por el D.S. 011-2011-PCM). Sin SMTP_HOST el envío se omite con
# un warning en el log y el admin verá "correo no enviado".
# - Local: Mailpit (`docker compose up -d mailpit`) → 127.0.0.1:1025, sin
#   usuario; los correos se ven en http://localhost:8025.
# - Producción: SMTP real del dominio (p.ej. smtp.hostinger.com, puerto 465
#   con TLS implícito o 587 con STARTTLS) y un buzón del propio dominio.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# Remitente visible. Debe ser un buzón del dominio autorizado por el SMTP.
MAIL_FROM="Mirana Shop <no-reply@tu-dominio.pe>"
