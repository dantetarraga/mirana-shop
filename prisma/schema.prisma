generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  AVAILABLE
  PREORDER
  SOLD_OUT
  COMING_SOON
  ARCHIVED
}

enum OrderStatus {
  PENDING
  AWAITING_PROOF
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WHATSAPP_TRANSFER
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum InventoryStockType {
  NORMAL
  PREORDER
}

/// Cómo se paga una línea de preventa: todo ahora, o adelanto ahora y saldo después.
enum PreorderMode {
  FULL
  PARTIAL
}

enum PreorderStatus {
  PENDING // Reserva creada, pendiente de depósito
  CONFIRMED // Depósito recibido y confirmado
  READY // Producto en stock, listo para cobrar saldo
  CONVERTED // Convertida en Order final
  CANCELLED
  EXPIRED
}

/// Naturaleza de una forma de entrega. Solo cambia los textos y los iconos que
/// ve el cliente: lo que decide si se pide dirección o sede son los flags
/// `requiresAddress` / `requiresLocation` de DeliveryMethod.
enum DeliveryKind {
  PICKUP // Retiro en tienda
  PREORDER // Preventa: se coordina cuando llega la mercadería
  SHIPPING // Envío a domicilio
}

// ---------------------------------------------------------------------------
// Auth.js / NextAuth models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          Role      @default(CUSTOMER)

  // Versión de sesión: viaja en el JWT (`sv`) y se compara con la BD en cada
  // guard. Incrementarla revoca todas las sesiones emitidas de la cuenta
  // (cambio de contraseña o de rol, baja, "Cerrar sesiones" en el admin).
  sessionVersion Int @default(0)

  termsAcceptedAt DateTime? // Fecha en que aceptó los Términos y Condiciones
  termsVersion    String? // Versión del documento aceptado, e.g. "v1.0"

  profile   Profile?
  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  preorders Preorder[]
  addresses UserAddress[]
  cart      Cart?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([deletedAt])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone     String?
  dni       String?
  hasKids   Boolean @default(false)
  kidsCount Int?

  updatedAt DateTime @updatedAt
}

model UserAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String  @default("Casa") // "Casa", "Trabajo", "Otro"
  fullName  String
  phone     String
  address   String
  district  String
  city      String  @default("Lima")
  reference String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  /// Único entre hermanas (ver @@unique). Ojo: en MariaDB los NULL no chocan
  /// en un índice único, así que la unicidad entre raíces la valida la action.
  name        String
  slug        String  @unique
  parentId    String?
  description String? @db.Text
  imageUrl    String?
  /// Orden entre hermanas (menú, árbol del admin, chips de subcategorías).
  position    Int     @default(0)
  /// false = oculta en toda la tienda (menú, filtros, páginas). El admin la ve.
  isVisible   Boolean @default(true)
  /// Solo aplica a raíces: la categoría entra al mega-menú de la tienda.
  showInMenu  Boolean @default(false)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([parentId, name])
  @@index([parentId, position])
  @@index([slug])
}

model Brand {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  tagline     String? /// Subtítulo corto para el carrusel: "TAMASHII NATIONS", "ARTFX SERIES"
  description String? @db.Text
  /// Logo de la marca.
  imageUrl    String?
  /// Imagen ancha de cabecera para /marcas/[slug].
  heroUrl     String?
  /// Orden manual (índice de marcas, mega-menú).
  position    Int     @default(0)
  /// false = oculta en toda la tienda. El admin la ve.
  isVisible   Boolean @default(true)
  /// Aparece entre los logos del mega-menú (máx. MENU_MAX_FEATURED_BRANDS).
  featured    Boolean @default(false)

  products Product[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([featured, position])
  @@index([slug])
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique
  slug        String        @unique
  name        String
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  salePrice   Decimal?      @db.Decimal(10, 2)
  currency    String        @default("PEN")
  status      ProductStatus @default(AVAILABLE)
  featured    Boolean       @default(false)
  categoryId  String
  brandId     String

  /// Preventa parcial: el cliente paga un adelanto ahora y el saldo después.
  /// Solo tiene efecto con status = PREORDER.
  allowPartialPreorder Boolean @default(false)
  /// Porcentaje del adelanto (1-100). null = usa StoreSettings.preorderDepositPercent.
  /// Se aplica sobre el precio efectivo (salePrice si hay oferta, si no price).
  preorderDepositPercent Int?
  /// Fecha estimada de entrega mostrada en la ficha del producto.
  estimatedArrival DateTime?

  category    Category            @relation(fields: [categoryId], references: [id])
  brand       Brand               @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  inventory   ProductInventory?
  orderItems  OrderItem[]
  cartItems   CartItem[]
  movements   InventoryMovement[]
  preorders   Preorder[]
  collections  ProductCollection[]
  homeSections ProductHomeSection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, featured])
  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([deletedAt])
}

model ProductInventory {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  availableStock    Int  @default(0)
  reservedStock     Int  @default(0)
  preorderedStock   Int  @default(0)
  lowStockThreshold Int?
  /// Optimistic locking — se incrementa en cada actualización de stock
  version           Int  @default(0)

  updatedAt DateTime @updatedAt

  @@index([availableStock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// ---------------------------------------------------------------------------
// Cart — persistido en servidor, ligado a una cookie de sesión anónima
// (`sessionId`). Si el visitante inicia sesión, su carrito anónimo se
// fusiona con el carrito de su cuenta (`userId`) y se descarta el anónimo.
// ---------------------------------------------------------------------------

model Cart {
  id        String  @id @default(cuid())
  // Carrito anónimo: sessionId set, userId null. Carrito de cuenta: userId
  // set, sessionId null — nunca ambos a la vez (ver mergeAnonymousCartIntoUser),
  // así un dispositivo compartido no hereda el carrito de otra cuenta tras logout.
  sessionId String? @unique
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  /// Total o parcial, para productos de preventa que admiten adelanto.
  /// Va en la línea (no duplica el producto): cambiar de modo la sobrescribe.
  preorderMode PreorderMode @default(FULL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  /// Código legible para el cliente, ej: MIR-2024-0001
  code          String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  guestEmail    String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod

  subtotal      Decimal @db.Decimal(10, 2)
  shippingCost  Decimal @default(0) @db.Decimal(10, 2)
  /// Descuento aplicado por promociones activas al momento de la compra
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  /// Lo que el cliente paga AHORA (con preventa parcial, el adelanto).
  /// Es también el monto del Payment asociado.
  total         Decimal @db.Decimal(10, 2)
  currency      String  @default("PEN")

  /// Saldo pendiente por preventa parcial. 0 en pedidos normales.
  /// `subtotal` sigue siendo el valor completo del pedido: total + dueTotal
  /// solo coinciden con él cuando no hay envío ni descuento.
  dueTotal  Decimal   @default(0) @db.Decimal(10, 2)
  /// Cuándo el admin marcó el saldo como cobrado. null = sigue pendiente.
  duePaidAt DateTime?

  /// Forma de entrega elegida en el checkout. El nombre y la sede se guardan
  /// como snapshot porque el método se puede renombrar o eliminar después.
  deliveryMethodId   String?
  deliveryMethod     DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  deliveryMethodName String          @default("")
  deliveryKind       DeliveryKind    @default(SHIPPING)
  /// Sede de retiro elegida, ya formateada: "LIMA — Av. José Pardo 1167 Int. 206"
  deliveryLocation   String?         @db.Text

  /// Cupón canjeado, si el descuento/envío gratis vino de uno.
  /// `couponCode` es snapshot: el cupón se puede eliminar después.
  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id])
  couponCode String?

  /// Cuándo el cliente marcó la casilla de Términos y Condiciones al comprar.
  termsAcceptedAt DateTime?

  /// Mientras el pedido espera comprobante, el stock queda reservado hasta
  /// esta fecha. El cron de órdenes cancela y libera las reservas vencidas.
  reservationExpiresAt DateTime?

  items     OrderItem[]
  payment   Payment?
  shipping  ShippingAddress?
  movements InventoryMovement[]
  preorder  Preorder?

  notes String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  cancelledAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deliveryMethodId])
  @@index([couponId])
  @@index([status, reservationExpiresAt])
}

// ---------------------------------------------------------------------------
// Rate limiting persistente para endpoints públicos sensibles.
// La key es un HMAC: nunca guarda IPs ni correos en claro.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  /// Snapshot del nombre al momento de la compra
  productName String
  /// Snapshot del SKU al momento de la compra
  productSku  String

  /// La línea se vendió como preventa (el stock se comprometió en
  /// `preorderedStock`, no en `reservedStock`). Es un snapshot: el producto
  /// pasa a AVAILABLE cuando llega la mercadería, así que no se puede deducir
  /// del estado actual al cancelar o aceptar el pedido más tarde.
  isPreorder       Boolean      @default(false)
  /// Cómo se pagó esta línea. FULL en todo pedido que no sea preventa parcial.
  preorderMode     PreorderMode @default(FULL)
  /// Snapshot del adelanto por unidad al momento de la compra (null si FULL).
  /// Se guarda el monto, no el porcentaje: el % del producto puede cambiar después.
  depositUnitPrice Decimal?     @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  status   PaymentStatus @default(UNPAID)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("PEN")

  /// URL del comprobante de pago enviado por el cliente (WhatsApp)
  proofUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Datos de entrega del pedido. Se crea siempre — también en retiro en tienda,
/// donde guarda el contacto (nombre, teléfono, DNI) y deja la dirección vacía.
model ShippingAddress {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fullName  String
  phone     String
  /// DNI del cliente — obligatorio para la boleta/factura y para el retiro
  dni       String  @default("")
  address   String  @default("")
  district  String  @default("")
  city      String  @default("Lima")
  reference String?
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id])

  type         InventoryMovementType
  stockType    InventoryStockType    @default(NORMAL)
  quantity     Int
  balanceAfter Int
  reason       String?
  /// ID del usuario admin que generó el movimiento manual, si aplica
  createdById  String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Preorders
// ---------------------------------------------------------------------------

model Preorder {
  id         String  @id @default(cuid())
  /// Código legible para el cliente, ej: PRE-2025-0001
  code       String  @unique
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  guestEmail String?
  productId  String
  product    Product @relation(fields: [productId], references: [id])

  quantity        Int
  unitPrice       Decimal @db.Decimal(10, 2)
  depositAmount   Decimal @db.Decimal(10, 2)
  remainingAmount Decimal @db.Decimal(10, 2)
  currency        String  @default("PEN")

  status           PreorderStatus @default(PENDING)
  estimatedArrival DateTime?
  /// Si no paga el depósito en X días, la reserva expira
  expiresAt        DateTime?

  /// Pago del depósito — transferencia/WhatsApp manual
  depositStatus   PaymentStatus  @default(UNPAID)
  depositMethod   PaymentMethod?
  depositPaidAt   DateTime?
  depositProofUrl String?

  /// Cuando la reserva se convierte en pedido final
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  notes String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?
  convertedAt DateTime?

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

model Collection {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  active      Boolean @default(true)

  products ProductCollection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([active])
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Secciones del inicio creadas desde el admin. Funcionan como "Novedades",
// pero en vez de calcular la lista (los últimos N) muestran los productos que
// se les enlazan uno a uno desde la ficha de producto.
// ---------------------------------------------------------------------------

model HomeSection {
  id String @id @default(cuid())
  /// Título grande de la sección — el "Novedades" del inicio
  title String
  /// Antetítulo pequeño encima del título. Vacío = no se pinta.
  eyebrow String @default("")
  /// Destino del botón "Ver todos". Vacío = /catalogo.
  ctaHref String @default("")
  /// Orden en el inicio, de menor a mayor
  position Int @default(0)
  /// Oculta = no se pinta en el inicio; en el admin sigue visible para editarla
  active Boolean @default(true)

  products ProductHomeSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model ProductHomeSection {
  productId String
  sectionId String

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  section HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

enum PromotionType {
  FREE_SHIPPING
  FIXED_DISCOUNT
  PERCENT_DISCOUNT
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  type        PromotionType
  active      Boolean       @default(true)

  /// Monto mínimo de compra (en PEN) para activar la promoción
  minAmount       Decimal? @db.Decimal(10, 2)
  /// Descuento fijo en soles (para FIXED_DISCOUNT)
  discountAmount  Decimal? @db.Decimal(10, 2)
  /// Porcentaje de descuento 0-100 (para PERCENT_DISCOUNT)
  discountPercent Decimal? @db.Decimal(5, 2)

  /// La promoción NO se aplica sola: hace falta que el cliente escriba uno de
  /// sus cupones en el checkout. Con `false` sigue siendo automática como antes.
  requiresCoupon Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  coupons Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
}

// ---------------------------------------------------------------------------
// Cupones — códigos que desbloquean una promoción concreta en el checkout.
// Varios cupones pueden apuntar a la misma promoción (ej. una campaña con un
// código por influencer): el beneficio siempre lo define la promoción.
// ---------------------------------------------------------------------------

model Coupon {
  id String @id @default(cuid())
  /// Se guarda y se compara SIEMPRE en mayúsculas y sin espacios
  code String @unique

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  /// Límite total de canjes; null = ilimitado
  maxUses   Int?
  /// Canjes consumidos. Se incrementa dentro de la transacción del pedido.
  usedCount Int  @default(0)

  /// Vigencia propia del código, además de la de la promoción
  startsAt DateTime?
  endsAt   DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([promotionId])
}

// ---------------------------------------------------------------------------
// Formas de entrega mostradas en el checkout (retiro en tienda, preventa,
// envío local...). El costo, el texto y las sedes se administran en
// /admin/delivery; el checkout solo lee lo que hay configurado.
// ---------------------------------------------------------------------------

model DeliveryMethod {
  id          String       @id @default(cuid())
  name        String
  description String?      @db.Text
  kind        DeliveryKind @default(SHIPPING)
  /// Costo que se suma al pedido. 0 = "Gratis".
  cost        Decimal      @default(0) @db.Decimal(10, 2)

  /// El cliente debe escribir su dirección de entrega. Falso en retiro en
  /// tienda y en preventa (ahí el envío se coordina después).
  requiresAddress  Boolean @default(true)
  /// El cliente debe elegir una de las sedes de `locations`.
  requiresLocation Boolean @default(false)

  position Int     @default(0)
  active   Boolean @default(true)

  locations DeliveryLocation[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

/// Sede/punto de entrega de un método (las tiendas donde se puede retirar).
model DeliveryLocation {
  id       String         @id @default(cuid())
  methodId String
  method   DeliveryMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  /// Etiqueta corta de la sede: "LIMA", "AREQUIPA"
  label   String
  address String
  /// Enlace a Google Maps para el botón "Ver en el mapa" del checkout
  mapUrl  String? @db.Text

  position Int @default(0)

  @@index([methodId, position])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Banner {
  id             String        @id @default(cuid())
  /// Opcional: un banner puede ser solo imagen, sin texto encima.
  title          String?
  subtitle       String?
  // Tres variantes de imagen, TODAS opcionales. imageUrl = desktop (formato
  // tarjeta). imageUrlMobile = mobile/tablet. imageUrlFull = desktop cuando la
  // tienda muestra los banners a pantalla completa (StoreSettings.bannerLayout
  // = FULLSCREEN). Las que falten se degradan a la primera disponible.
  //
  // Un banner sin ninguna imagen no se puede pintar: la tienda lo omite aunque
  // esté activo (ver hasBannerImage en features/banners/lib/banner-image.ts).
  imageUrl       String?
  imageUrlMobile String?
  imageUrlFull   String?
  ctaLabel       String?
  ctaHref        String?
  position       Int       @default(0)
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ---------------------------------------------------------------------------
// Contenido legal editable desde el admin (términos, políticas)
// ---------------------------------------------------------------------------

model LegalPage {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CTA del home (franja "Ediciones Limitadas") — editable desde el admin.
// Registro único con id fijo 'home-cta'.
// ---------------------------------------------------------------------------

model HomeCta {
  id       String  @id
  title    String  @default("")
  subtitle String  @default("")
  ctaLabel String  @default("")
  ctaHref  String  @default("")
  imageUrl String  @default("")
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Configuración general de la tienda — registro único con id 'store'
// ---------------------------------------------------------------------------

/// Cómo se muestran TODOS los banners del inicio. Es un ajuste global de la
/// tienda (/admin/settings), no una propiedad de cada banner.
/// CARD       = grid de tarjetas; a partir de 4 se vuelve carrusel.
/// FULLSCREEN = hero a ancho completo; varios se cruzan con fundido de opacidad.
enum BannerLayout {
  CARD
  FULLSCREEN
}

model StoreSettings {
  id               String       @id
  showOutOfStock   Boolean      @default(true)
  whatsappNumber   String       @default("")
  baseShippingCost Decimal      @default(15) @db.Decimal(10, 2)
  bannerLayout     BannerLayout @default(CARD)
  /// Adelanto por defecto de la preventa parcial (1-100). Cada producto puede
  /// sobrescribirlo con Product.preorderDepositPercent.
  preorderDepositPercent Int @default(50)
  /// Bloques fijos del inicio (novedades, favoritos, reseñas...) que el admin
  /// ocultó, separados por coma. Las claves viven en features/home/lib/home-blocks.ts.
  /// Vacío = se muestran todos, que es como estaba antes de existir el ajuste.
  hiddenHomeBlocks String @default("")
  /// Logo personalizado del footer (URL de Cloudinary). Si está vacío se usa el texto MIRANA.
  footerLogoUrl    String @default("")
  /// URLs de redes sociales mostradas en el footer.
  instagramUrl     String @default("")
  tiktokUrl        String @default("")
  youtubeUrl       String @default("")
  facebookUrl      String @default("")

  /// Datos del proveedor exigidos en la Hoja de Reclamación (Anexo I del
  /// D.S. 011-2011-PCM) y visibles en el footer. null = aún sin configurar.
  legalName     String? /// Razón social
  ruc           String? @db.VarChar(11)
  fiscalAddress String? @db.VarChar(300) /// Domicilio fiscal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Métodos de pago manuales mostrados en el checkout (Yape, BCP, BBVA, etc.)
// ---------------------------------------------------------------------------

model PaymentAccount {
  id       String  @id @default(cuid())
  name     String
  holder   String  @default("")
  number   String
  cci      String  @default("")
  /// Código QR para escanear desde la app (Yape, Plin). Vacío = no se muestra.
  /// Las transferencias bancarias normalmente no lo usan.
  qrImageUrl String @default("")
  /// Logo de la marca (Yape, BCP, Interbank...). Vacío = se cae al ícono por
  /// defecto según el método tenga CCI o no.
  logoUrl    String @default("")
  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ---------------------------------------------------------------------------
// Alertas del admin — generadas por el cron /api/cron/alerts
// ---------------------------------------------------------------------------

enum AdminAlertType {
  LOW_STOCK
  PENDING_ORDERS
  PROMO_EXPIRING
  DAILY_SUMMARY
  /// Reclamos vencidos o por vencer (plazo legal de 15 días hábiles)
  COMPLAINT_DUE
}

model AdminAlert {
  id      String         @id @default(cuid())
  type    AdminAlertType
  title   String
  message String         @db.Text
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Libro de Reclamaciones Virtual — formato exigido por Indecopi (Perú,
// DS 011-2011-PCM). El cliente llena el formulario público sin necesidad de
// cuenta; el admin responde desde /admin/complaints dentro del plazo legal.
// ---------------------------------------------------------------------------

enum ComplaintType {
  RECLAMO
  QUEJA
}

/// Bien contratado según el Anexo I: producto o servicio.
enum ComplaintGoodType {
  PRODUCTO
  SERVICIO
}

enum ComplaintStatus {
  PENDING
  ANSWERED
}

/// Hoja del Libro de Reclamaciones Virtual (Ley 29571, D.S. 011-2011-PCM y
/// modificatorias D.S. 006-2014-PCM y D.S. 101-2022-PCM).
///
/// RETENCIÓN: el proveedor debe conservar las hojas y sus respuestas al menos
/// 2 años desde su registro. Por eso Complaint NO tiene `deletedAt`, NO aparece
/// en /admin/trash y NUNCA debe incluirse en purgas, borrados en cascada ni
/// limpiezas automáticas. Tampoco se edita: el consumidor no puede modificarla
/// y la respuesta del proveedor es de solo inserción (ComplaintResponse).
model Complaint {
  id   String @id @default(cuid())
  /// Código visible "LR-2026-000123". El orden real lo dan `year` + `seq`
  /// (numéricos), nunca el texto del código.
  code String @unique
  /// Año del registro en zona America/Lima
  year Int
  /// Correlativo dentro del año (1, 2, 3...)
  seq  Int

  // Datos del consumidor reclamante
  fullName  String
  docType   String @default("DNI")
  docNumber String
  address   String
  phone     String
  email     String

  // Menor de edad: datos del padre, madre o apoderado
  isMinor           Boolean @default(false)
  guardianName      String?
  guardianDocType   String?
  guardianDocNumber String?

  // Datos del bien contratado
  goodType           ComplaintGoodType @default(PRODUCTO)
  /// Nº de pedido de la tienda, si lo hay (snapshot de texto, sin FK)
  orderCode          String?
  productDescription String            @db.Text
  claimedAmount      Decimal?          @db.Decimal(10, 2)

  // Detalle de la reclamación
  type    ComplaintType
  detail  String        @db.Text
  request String        @db.Text

  // Declaraciones del consumidor al registrar la hoja
  truthDeclarationAccepted Boolean @default(false)
  /// Consentimiento para el tratamiento de datos personales (Ley 29733)
  privacyAccepted          Boolean @default(false)

  // Gestión del proveedor (admin). `response`, `providerActions` y
  // `respondedAt` son una copia de la única ComplaintResponse, escrita en la
  // misma transacción; no se vuelven a modificar.
  status          ComplaintStatus @default(PENDING)
  response        String?         @db.Text
  /// Observaciones y acciones adoptadas por el proveedor (Anexo I)
  providerActions String?         @db.Text
  respondedAt     DateTime?

  /// Vence el plazo legal de respuesta: 15 días hábiles (fin del día, Lima)
  dueAt               DateTime
  /// Constancia enviada al consumidor (null = no se pudo enviar)
  consumerEmailSentAt DateTime?
  /// Respuesta enviada al consumidor (null = no se pudo enviar)
  responseEmailSentAt DateTime?

  /// Respuesta inmutable (1:1). Ver ComplaintResponse.
  answer ComplaintResponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, seq])
  @@index([status, createdAt])
  @@index([status, dueAt])
}

/// Respuesta del proveedor a una hoja. Tabla de SOLO INSERCIÓN: la app nunca
/// hace update/delete sobre ella y `complaintId` es único, así que una hoja
/// tiene a lo sumo una respuesta y no se puede reescribir. Se conserva junto
/// con la hoja (≥ 2 años); onDelete Restrict impide borrarla en cascada.
model ComplaintResponse {
  id              String    @id @default(cuid())
  complaintId     String    @unique
  complaint       Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  body            String    @db.Text
  providerActions String?   @db.Text
  /// Email del admin que respondió (snapshot)
  respondedBy     String?
  createdAt       DateTime  @default(now())
}
